{
  "name": "iterate-plugin",
  "version": "2.9.1",
  "description": "dsh plugin that turns the iterate skill into an autonomous closed-loop harness: plan -> parallel review xN -> atomic fixes -> validate -> loop -> auto-stop, plus a dry-run pure-review mode with multi-round convergence and a meta-review that audits the report and emits a final review report.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jingzhao-l/iterate-plugin.git"
  },
  "homepage": "https://github.com/jingzhao-l/iterate-plugin#readme",
  "bugs": {
    "url": "https://github.com/jingzhao-l/iterate-plugin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "iterate",
    "code-review",
    "autonomous",
    "dry-run",
    "cordis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "files": [
    "src",
    "lib",
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "npm run build && npm run build:client",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json",
    "test": "tsx --test test/*.test.ts",
    "test:validate": "tsx --test test/validate.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "js-yaml": "4.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.15.0",
    "@types/react": "19.2.2",
    "esbuild": "0.25.12",
    "tsx": "4.20.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
