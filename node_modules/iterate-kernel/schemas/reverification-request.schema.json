{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iterate.dev/reverification-request-0.1.json",
  "title": "ReverificationRequest",
  "description": "The ask that comes out of a failed invariant report (5.7 R40 scenario 1): re-run these recipe steps, dimensions, or operations. It cites the failure by digest rather than embedding it, so the ledger line that records the re-verification can be checked against the ledger line that records the failure. NOTE ON SOURCE OF TRUTH: the field constraints are duplicated from `src/invariant-report.ts`, which is the definition; this file mirrors it. The 'an empty target set is not a re-verification' rule IS expressible here and is expressed twice on purpose, via `anyOf`, so a schema-only implementation refuses it too.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "trigger", "targets"],
  "properties": {
    "schemaVersion": {
      "const": "iterate.reverification/0.1"
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reportDigest"],
      "properties": {
        "kind": {
          "const": "invariant"
        },
        "reportDigest": {
          "type": "string",
          "pattern": "^iv_[0-9a-f]{64}$"
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["recipeSteps"]
        },
        {
          "required": ["dimensions"]
        },
        {
          "required": ["operationIds"]
        }
      ],
      "properties": {
        "recipeSteps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/recipeStep"
          }
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          }
        },
        "operationIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^op_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        }
      }
    }
  },
  "$defs": {
    "recipeStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "params"],
      "properties": {
        "kind": {
          "enum": ["act", "observe", "assert", "diagnose"]
        },
        "params": {
          "type": "object"
        }
      }
    }
  }
}
